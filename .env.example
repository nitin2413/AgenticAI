# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Options: openai, anthropic, google, ollama
LLM_PROVIDER=openai

# Model to use (varies by provider)
# OpenAI: gpt-4, gpt-3.5-turbo, gpt-4-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
# Google: gemini-pro, gemini-1.5-pro
# Ollama: llama2, mistral, neural-chat
LLM_MODEL=gpt-3.5-turbo

# API Key for the selected provider
# Get yours from: https://platform.openai.com/api-keys (OpenAI)
#               https://console.anthropic.com/account/keys (Anthropic)
#               https://makersuite.google.com/app/apikey (Google)
LLM_API_KEY=your-api-key-here

# Optional: Custom API endpoint (for OpenRouter, Azure, or self-hosted)
# LLM_BASE_URL=https://openrouter.ai/api/v1  # For OpenRouter
# LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>/  # For Azure
# LLM_BASE_URL=http://localhost:11434  # For Ollama
LLM_BASE_URL=

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0

# Maximum tokens to generate per response
LLM_MAX_TOKENS=4096

# ============================================================================
# Legacy OpenAI Settings (for backward compatibility - use above instead)
# ============================================================================
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-3.5-turbo
# BASE_URL=https://api.openai.com/v1
# MAX_TOKEN=4096

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME=Multi-Agent AI System
DEBUG=False

# ============================================================================
# Vector Database (ChromaDB)
# ============================================================================
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=documents

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
POSTGRES_URL=postgresql://postgres:password@localhost:5432/agent_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ============================================================================
# Gmail Integration
# ============================================================================
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=./token.json
SCOPES=https://www.googleapis.com/auth/gmail.readonly

# ============================================================================
# Provider-Specific Examples
# ============================================================================

# --- OpenAI (Default) ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1

# --- OpenRouter ---
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-4  # or any OpenRouter model
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-opus-20240229
# LLM_API_KEY=sk-ant-...

# --- Google Gemini ---
# LLM_PROVIDER=google
# LLM_MODEL=gemini-pro
# LLM_API_KEY=AIza...

# --- Azure OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4
# LLM_API_KEY=your-azure-key
# LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>/

# --- Local Ollama ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama2
# LLM_BASE_URL=http://localhost:11434
# (No API key needed for local Ollama)
